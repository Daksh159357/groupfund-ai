# ==============================================================================
# GroupFund AI — Environment Configuration
# ==============================================================================

# NEXT PUBLIC URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE CONFIGURATION (Optional for local test mode; provide for live database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GOOGLE GEMINI API (Used for receipt scanning, proposal generation & AI assistant)
GEMINI_API_KEY=your-gemini-api-key-here

# PAYPAL DEVELOPER SANDBOX CONFIGURATION
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_ENVIRONMENT=sandbox

# NEXT_PUBLIC_CURRENCY
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
